# ==============================================================================
# Discord Bot - Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# ==============================================================================

# --- Required Core API Credentials ---
DISCORD_BOT_TOKEN=your_discord_bot_token_here
TMDB_API_KEY=your_tmdb_api_key_here
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here
OPENWEATHERMAP_API_KEY=your_openweathermap_api_key_here

# --- Database & Port Settings ---
SQLITE_DB_PATH=data/app.db
PORT=5000

# --- Webhook & Reports (Optional) ---
WEBHOOK_BASE_URL=http://localhost:5000
WEBHOOK_SHARED_SECRET=
WEBHOOK_MAX_BYTES=51200
WEBHOOK_RATE_LIMIT_PER_MIN=30
ALLOW_EXTERNAL_CHARTS=True

# --- Standalone Secret File (Optional alternative to TMDB_API_KEY) ---
# TMDB_API_KEY_FILE=secrets/tmdb_api_key.txt

# --- Timer / Firebase Integration (Owner-only, Optional) ---
FIREBASE_DATABASE_URL=
FIREBASE_DATABASE_SECRET=
TIMER_OWNER_ID=0
DISCORD_SYNC_SECRET=
TIMER_AUTH_PASSWORD=

# --- Clockify Integration (Optional, non-global regions override) ---
CLOCKIFY_API_BASE_URL=https://api.clockify.me/api/v1
